# ==============================================================================
# Rubix Bootstrap Compiler: Code Generator & Assembly Emitter
# Written in 100% Pure Rubix (.ix)
# Memory layout for CodeEmitter heap object (4 QWORDs = 32 bytes):
#   offset 0  (0x00): out_buf           (int)
#   offset 8  (0x08): out_len           (int)
#   offset 16 (0x10): out_cap           (int)
#   offset 24 (0x18): out_label_counter (int)
# ==============================================================================

fn emitter_create(capacity: int): int {
    let em = alloc(32);
    let b = alloc(capacity);
    mem_set_u64(em, 0, b);
    mem_set_u64(em, 8, 0); # out_len = 0
    mem_set_u64(em, 16, capacity);
    mem_set_u64(em, 24, 1); # out_label_counter = 1
    return em;
}

fn emitter_get_buf(em: int): int {
    return mem_get_u64(em, 0);
}

fn emitter_get_len(em: int): int {
    return mem_get_u64(em, 8);
}

# Append raw bytes to emitter buffer
fn emit_bytes(em: int, src: int, src_len: int) {
    let b = mem_get_u64(em, 0);
    let l = mem_get_u64(em, 8);
    let i = 0;
    while (i < src_len) {
        mem_set_u8(b, l + i, mem_get_u8(src, i));
        i = i + 1;
    }
    mem_set_u64(em, 8, l + src_len);
}

# Append null-terminated C-string to emitter buffer
fn emit_str(em: int, s: int) {
    let length = str_len(s);
    emit_bytes(em, s, length);
}

fn emit_newline(em: int) {
    let b = mem_get_u64(em, 0);
    let l = mem_get_u64(em, 8);
    mem_set_u8(b, l, 10); # '\n'
    mem_set_u64(em, 8, l + 1);
}

# Convert integer to string and emit
fn emit_int(em: int, val: int) {
    if (val == 0) {
        let b = mem_get_u64(em, 0);
        let l = mem_get_u64(em, 8);
        mem_set_u8(b, l, 48); # '0'
        mem_set_u64(em, 8, l + 1);
        return;
    }

    let is_neg = false;
    let n = val;
    if (n < 0) {
        is_neg = true;
        n = 0 - n;
    }

    let temp = alloc(32);
    let count = 0;
    while (n > 0) {
        let rem = n % 10;
        temp[count] = 48 + rem;
        count = count + 1;
        n = n / 10;
    }

    let b = mem_get_u64(em, 0);
    let l = mem_get_u64(em, 8);
    if (is_neg) {
        mem_set_u8(b, l, 45); # '-'
        l = l + 1;
    }

    let i = 0;
    while (i < count) {
        mem_set_u8(b, l + i, temp[count - 1 - i]);
        i = i + 1;
    }
    mem_set_u64(em, 8, l + count);
    free(temp, 32);
}

fn emit_label(em: int, prefix: int, id: int) {
    emit_str(em, prefix);
    emit_int(em, id);
    emit_str(em, ":\n");
}
