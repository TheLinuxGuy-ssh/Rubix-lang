fn check_status(is_active: bool, flag: bool): int {
    if (is_active && !flag) {
        return 1;
    }
    return 0;
}

fn main() {
    print_str("--- Booleans and Characters ---\n");
    let b: bool = true;
    let f: bool = false;
    let c: char = 'R';
    print_char(c);
    let nl = 10;
    print_char(nl);

    if (b || f) {
        print(1);
    } else {
        print(0);
    }

    if (b && f) {
        print(0);
    } else {
        print(2);
    }

    let status = check_status(true, false);
    print(status);
    return 0;
}
